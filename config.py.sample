        "api_key": "your_api_key_here",
        "model": "glm-5",
        #"effort": "thinking-disabled", # default enabled
    },
    "deepseek/deepseek-v4-pro": {
        "api_url": "https://api.novita.ai/openai/chat/completions",
        "api_key": "your_api_key_here",
        "model": "deepseek/deepseek-v4-pro",
